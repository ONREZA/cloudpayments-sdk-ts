{
	"name": "@onreza/cloudpayments-sdk",
	"version": "0.5.0",
	"description": "Типизированный TypeScript SDK для API CloudPayments",
	"type": "module",
	"license": "MIT",
	"author": "ONREZA",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ONREZA/cloudpayments-sdk-ts.git"
	},
	"bugs": {
		"url": "https://github.com/ONREZA/cloudpayments-sdk-ts/issues"
	},
	"homepage": "https://github.com/ONREZA/cloudpayments-sdk-ts#readme",
	"keywords": [
		"cloudpayments",
		"payments",
		"acquiring",
		"sdk",
		"typescript"
	],
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.4.4",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./webhooks": {
			"types": "./dist/webhooks.d.ts",
			"default": "./dist/webhooks.js"
		},
		"./errors": {
			"types": "./dist/errors.d.ts",
			"default": "./dist/errors.js"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"default": "./dist/browser.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "bun --bun run tsdown",
		"dev": "bun --bun run tsdown --watch",
		"test": "bun test --parallel test/unit",
		"test:integration": "bun test test/integration",
		"test:all": "bun test",
		"typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit --stableTypeOrdering --checkers 1",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --fix --deny-warnings .",
		"format": "bun fmt",
		"gen": "bun tools/gen.ts",
		"gen:check": "bun tools/check-generated.ts",
		"verify": "bun run gen:check && bun run format:check && bun run lint && bun run typecheck && bun run typecheck:tools && bun run typecheck:portable && bun run test && bun run build && bun run package:check",
		"package:smoke": "bun run package:check",
		"docs:scrape": "bun tools/scrape.ts",
		"docs:parse": "bun tools/parse.ts",
		"docs:sync": "bun run spec:sync",
		"prepare": "lefthook install || echo 'Install lefthook: https://github.com/evilmartians/lefthook'",
		"prepack": "bun run gen:check && bun run build",
		"test:changed": "bun test --parallel --changed test/unit",
		"test:tools": "bun test --parallel test/unit/docs-parser.test.ts test/unit/docs-generator.test.ts test/unit/docs-sync.test.ts test/unit/docs-report.test.ts test/unit/lint.test.ts test/unit/workflows.test.ts",
		"typecheck:tools": "node node_modules/@typescript/native/bin/tsc --noEmit --stableTypeOrdering --checkers 1 -p tsconfig.tools.json",
		"typecheck:portable": "node node_modules/@typescript/native/bin/tsc --noEmit --stableTypeOrdering --checkers 1 -p tsconfig.portable.json",
		"format:check": "bun fmt --check",
		"package:check": "node tools/check-package.mjs",
		"spec:fetch": "bun tools/fetch.ts",
		"spec:diff": "bun tools/diff.ts",
		"spec:sync": "bun tools/sync.ts"
	},
	"dependencies": {},
	"devDependencies": {
		"@typescript/native": "npm:typescript@7.0.2",
		"@types/bun": "1.4.4",
		"cheerio": "1.2.0",
		"lefthook": "2.2.2",
		"tsdown": "0.23.4",
		"typescript": "6.0.3",
		"oxlint": "1.90.0",
		"publint": "0.3.25",
		"@arethetypeswrong/core": "0.18.5"
	}
}
